---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Overlays from '../components/overlays/Overlays.astro';
// Preload the fonts used above the fold so text doesn't wait for the stylesheet chain
// (the italic is the hero's "dla Ciebie"; loading it late shifted the page).
import sansRegular from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import serifRegular from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import sansSemibold from '@fontsource/instrument-sans/files/instrument-sans-latin-600-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import uaSerif from '@fontsource/playfair-display/files/playfair-display-cyrillic-400-normal.woff2?url';
import uaSerifItalic from '@fontsource/playfair-display/files/playfair-display-cyrillic-400-italic.woff2?url';
import uaSans from '@fontsource/onest/files/onest-cyrillic-400-normal.woff2?url';
// Onest keeps digits and punctuation (— · /) in its Latin file, used by the hero text too.
import uaSansLatin from '@fontsource/onest/files/onest-latin-400-normal.woff2?url';
import uaSansSemibold from '@fontsource/onest/files/onest-cyrillic-600-normal.woff2?url';
import { getContent, htmlLang, ogLocale, localePath, locales, defaultLocale, isTranslated, type Locale } from '../data';

/** notFound: the 404 page. No canonical/hreflang, kept out of search, and header/footer links point back to the homepage. */
type Props = { locale: Locale; title?: string; description?: string; notFound?: boolean };

const { locale, notFound = false } = Astro.props;
const content = getContent(locale);
const title = Astro.props.title ?? content.ui.seoTitle;
const description = Astro.props.description ?? content.site.hero.lead;
const canonical = new URL(localePath[locale], Astro.site);
// Until a language is translated its page shows Polish text: say so in <html lang>,
// keep the copy out of search results and out of the hreflang alternates.
const translated = isTranslated(locale) && !notFound;
const linkBase = notFound ? localePath[locale] : '';
const alternates = locales.filter(isTranslated);
---

<!doctype html>
<html lang={htmlLang[content.contentLocale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {
      (content.contentLocale === 'ua'
        ? [uaSans, uaSansLatin, uaSerif, uaSerifItalic, uaSansSemibold]
        : [sansRegular, serifRegular, serifItalic, sansSemibold]
      ).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {translated ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, follow" />}
    {
      translated &&
        alternates.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localePath[l], Astro.site)} />)
    }
    {translated && <link rel="alternate" hreflang="x-default" href={new URL(localePath[defaultLocale], Astro.site)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale[content.contentLocale]} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body id="top">
    <a class="skip-link" href="#content">{content.ui.skipToContent}</a>
    <Header locale={locale} content={content} linkBase={linkBase} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer content={content} linkBase={linkBase} />
    <Overlays locale={locale} content={content} linkBase={linkBase} />
  </body>
</html>
