---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Overlays from '../components/overlays/Overlays.astro';
import { getContent, htmlLang, localePath, locales, defaultLocale, type Locale } from '../data';

type Props = { locale: Locale; title?: string; description?: string };

const { locale } = Astro.props;
const content = getContent(locale);
const title = Astro.props.title ?? 'Massage Heaven — masaż w centrum Warszawy';
const description = Astro.props.description ?? content.site.hero.lead;
const canonical = new URL(localePath[locale], Astro.site);
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localePath[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath[defaultLocale], Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body id="top">
    <a class="skip-link" href="#content">{content.ui.skipToContent}</a>
    <Header locale={locale} content={content} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer content={content} />
    <Overlays locale={locale} content={content} />
  </body>
</html>
