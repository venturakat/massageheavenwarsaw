---
/**
 * Team card (Figma 152:104, instances 156:836 / 156:837).
 * Circular cut-out portrait on a plum gradient, name, arrow link that opens
 * the therapist's booking chooser. Sits on the plum-600 team section.
 */
import { Image } from 'astro:assets';
import IconLink from './IconLink.astro';
import { teamPhotos } from '../data/team-photos';

type Props = {
  id: string;
  name: string;
  bookingLabel: string;
  chooser: string;
  photoAlt: string;
};

const { id, name, bookingLabel, chooser, photoAlt } = Astro.props;
const photo = teamPhotos[id];
---

<article class="team-card">
  <div class="team-card__photo">
    {photo && <Image src={photo} alt={photoAlt} widths={[290, 580]} sizes="290px" loading="lazy" />}
  </div>
  <h3 class="team-card__name">{name}</h3>
  <IconLink kind="arrow" data-booking={chooser} aria-haspopup="dialog">{bookingLabel}</IconLink>
</article>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    width: 290px;
  }

  .team-card__photo {
    width: 290px;
    height: 290px;
    overflow: hidden;
    border-radius: 50%;
    background: linear-gradient(to bottom, var(--bg-highlight), var(--plum-700));
  }
  .team-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }

  .team-card__name {
    font: var(--type-h3);
    letter-spacing: var(--tracking-h3);
    color: var(--text-inverse);
  }
</style>
