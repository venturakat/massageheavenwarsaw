---
/**
 * About — "Poznaj gabinet" (Figma desktop 97:64, mobile 240:1241). Anchor #o-nas.
 * Studio photo under an 85 % plum tint, copy + three features.
 */
import { Image } from 'astro:assets';
import SectionTitle from '../SectionTitle.astro';
import studio from '../../assets/about/studio.png';
import type { Content } from '../../data';

type Props = { content: Content };
const { site, ui } = Astro.props.content;
const { about } = site;
// One text, edited in the admin as one field: a blank line starts a new paragraph.
const paragraphs = about.text
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<section id="o-nas" class="about" aria-labelledby="about-title">
  <div class="about__bg">
    <Image src={studio} alt={ui.alt.studio} widths={[768, 1376]} sizes="100vw" loading="lazy" />
  </div>

  <div class="container about__inner">
    <SectionTitle eyebrow={about.eyebrow} title={about.title} tone="dark" id="about-title" />
    <div class="about__text">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <ul class="about__features" role="list">
      {
        about.features.map((f) => (
          <li class="about__feature">
            <h3 class="about__feature-title">{f.title}</h3>
            <p class="about__feature-text">{f.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    position: relative;
    isolation: isolate;
    padding-block: var(--section-pad-mobile);
    color: var(--text-inverse);
    overflow: hidden;
  }

  .about__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .about__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
  }
  .about__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--plum-500) 85%, transparent);
  }

  .about__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* About spaces the eyebrow like the rest of the copy (Figma 97:66). */
  .about__inner :global(.section-title) { gap: 24px; }

  .about__text {
    display: flex;
    flex-direction: column;
    font: var(--type-lead);
  }

  .about__features {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--plum-300);
  }
  .about__feature {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .about__feature-title { font: var(--type-price); }
  .about__feature-text { color: var(--text-inverse-subtle); }

  @media (min-width: 768px) {
    .about__features { flex-direction: row; gap: 32px; }
    .about__feature { flex: 1 1 0; }
  }

  @media (min-width: 1024px) {
    /* Figma 97:64 is a fixed 660 px frame with the copy centred (86 px above and below). */
    /* Grid (not flex) so .container keeps its own width and side margins. */
    .about {
      display: grid;
      align-content: center;
      min-height: 660px;
      padding-block: var(--section-pad-desktop);
    }
    .about__inner,
    .about__inner :global(.section-title) { gap: 32px; }
    .about__inner > * { max-width: 664px; }
    .about__text { max-width: 653px; }
    .about__features { padding-top: 32px; }
  }
</style>
