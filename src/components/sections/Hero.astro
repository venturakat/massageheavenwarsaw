---
/**
 * Hero (Figma desktop 95:26, mobile 240:1065). Anchor #start.
 * Desktop: copy left, two arch photos + halo right (scaled with the width).
 * Below 1024 px: copy only, full-width buttons.
 */
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import dot from '../../assets/icons/dot.svg';
import halo from '../../assets/hero/halo.svg';
import archLarge from '../../assets/hero/arch-large.png';
import archSmall from '../../assets/hero/arch-small.png';
import type { Content } from '../../data';

type Props = { content: Content };
const { site, ui } = Astro.props.content;
const { hero, studio } = site;
const [bookLabel, pricesLabel, mapLabel] = hero.actions;
---

<section id="start" class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="label hero__eyebrow">
        <img src={dot.src} width="8" height="8" alt="" />
        {hero.eyebrow}
      </p>
      <h1 class="hero__title" id="hero-title">
        {hero.title[0]}<br /><em>{hero.title[1]}</em>
      </h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__actions">
        <Button class="hero__book" data-booking="general" aria-haspopup="dialog">{bookLabel}</Button>
        <div class="hero__secondary">
          <Button variant="secondary" href="#cennik">{pricesLabel}</Button>
          <Button variant="secondary" href={studio.googleMaps} target="_blank" rel="noopener">
            {mapLabel}<span class="visually-hidden"> {ui.newTab}</span>
          </Button>
        </div>
      </div>
    </div>

    <div class="hero__visual">
      <Image class="hero__arch hero__arch--large" src={archLarge} alt={ui.alt.heroLarge} width={342} height={420} fit="fill" densities={[1, 1.5]} loading="eager" fetchpriority="high" />
      <div class="hero__arch hero__arch--small">
        <Image src={archSmall} alt={ui.alt.heroSmall} width={263} height={323} fit="fill" densities={[1, 2]} loading="eager" />
      </div>
      <img class="hero__halo" src={halo.src} width="207" height="33" alt="" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 32px;
    background: linear-gradient(to bottom, var(--periwinkle-100), var(--periwinkle-200));
    overflow: hidden;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-accent);
    line-height: 15px;
  }

  .hero__title {
    font: var(--type-display);
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
  }
  .hero__title em {
    font-style: italic;
    color: var(--text-highlight);
  }

  .hero__lead {
    max-width: 520px;
    font: var(--type-lead);
    /* Darker than Figma's text-secondary: on the lavender gradient that is ~4.3:1,
       below the 4.5:1 minimum. neutral-600 gives ~6.8:1. */
    color: var(--neutral-600);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  .hero__secondary {
    display: flex;
    gap: 12px;
  }
  .hero__actions :global(.btn) { padding-inline: 17px; }
  .hero__secondary :global(.btn) { flex: 1 1 0; min-width: 0; }

  .hero__visual { display: none; }

  @media (min-width: 768px) {
    .hero__actions { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 12px 16px; width: auto; }
    .hero__secondary { gap: 16px; }
    .hero__secondary :global(.btn) { flex: none; }
  }

  /* ── Desktop ── */
  @media (min-width: 1024px) {
    .hero { padding-block: 45px 0; }

    .hero__inner {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
    }

    .hero__copy {
      flex: 0 1 var(--hero-copy-width);
      gap: 32px;
      padding-bottom: 80px;
    }

    /* 517 × 488 in Figma; children positioned in % so it scales down at 1024. */
    .hero__visual {
      display: block;
      position: relative;
      flex: 0 1 517px;
      aspect-ratio: 517 / 488;
    }

    .hero__arch {
      position: absolute;
      overflow: hidden;
      border-radius: 50% 50% 0 0 / 40.6% 40.6% 0 0;
    }
    /* Figma fills each arch with the whole photo, stretched to the shape (not cropped).
       The images are generated at exactly that shape (fit="fill"), 1× and 2×
       (1.5× for the large arch: its source photo is only 649 px tall). */
    .hero__arch,
    .hero__arch :global(img) { object-fit: fill; }
    .hero__arch--large {
      left: 33.85%;
      top: 13.74%;
      width: 66.08%;
      height: 86.17%;
    }
    .hero__arch--small {
      left: 0;
      top: 33.72%;
      width: 50.76%;
      height: 66.19%;
    }
    .hero__arch--small :global(img) {
      width: 100%;
      height: 100%;
    }
    /* Plum tint, 85 % (Figma). */
    .hero__arch--small::after {
      content: '';
      position: absolute;
      inset: 0;
      background: color-mix(in srgb, var(--plum-500) 85%, transparent);
    }

    .hero__halo {
      position: absolute;
      left: 47%;
      top: 4.09%;
      width: 40.01%;
      height: auto;
    }
  }
</style>
