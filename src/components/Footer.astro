---
/**
 * Site footer (Figma desktop 97:151, mobile 240:1334).
 * The "Online" column links straight to each channel (the only booking links
 * that skip the chooser). Legal buttons open pop-ups built in step 4.
 */
import logo from '../assets/brand/logo-white.svg';
import TextLink from './TextLink.astro';
import type { Content } from '../data';

/** linkBase: see Header.astro. */
type Props = { content: Content; linkBase?: string };
const { content, linkBase = '' } = Astro.props;
const { site, ui } = content;
const { columns, copyright, legal } = site.footer;

const general = site.booking.general.groups.flatMap((g) => g.options);
const channelUrl = (id: string) => general.find((o) => o.id === id)?.url;
const online = [
  { label: columns.online.links[0], href: channelUrl('booksy') },
  { label: columns.online.links[1], href: channelUrl('fresha') },
  { label: columns.online.links[2], href: channelUrl('whatsapp') },
  { label: columns.online.links[3], href: site.studio.instagramProfile },
];
const [privacyLabel, cookiesLabel] = legal;

// The footer menu may use shorter labels than the header ("Bon" for "Bon podarunkowy").
const menuShort = (columns.menuShort ?? {}) as Record<string, string>;
const footerLabel = (item: { label: string; anchor: string }) => menuShort[item.anchor] ?? item.label;

// Opening hours: one row per run of neighbouring days with the same times (Czw–Pt 8:30–23:00).
const hoursCopy = columns.hours;
const dayKeys = Object.keys(hoursCopy.days) as (keyof typeof hoursCopy.days)[];
const studioHours = site.studio.hours as Record<string, string>;
const isOpen = (value: string | undefined) => Boolean(value && /\d/.test(value));
const hourRows: { short: string; long: string; time: string }[] = [];
for (let i = 0; i < dayKeys.length; ) {
  const time = studioHours[dayKeys[i]] ?? '';
  let j = i;
  while (j + 1 < dayKeys.length && (studioHours[dayKeys[j + 1]] ?? '') === time) j++;
  const [first, last] = [hoursCopy.days[dayKeys[i]], hoursCopy.days[dayKeys[j]]];
  hourRows.push({
    short: i === j ? first[0] : `${first[0]}–${last[0]}`,
    long: i === j ? first[1] : `${first[1]}–${last[1]}`,
    time: isOpen(time) ? time : hoursCopy.closed,
  });
  i = j + 1;
}
---

<footer class="site-footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href={`${linkBase}#top`} aria-label={ui.logoHome}>
          <img src={logo.src} width="240" height="44" alt="" loading="lazy" />
        </a>
        <p class="footer__tagline">{site.taglines.footer}</p>
      </div>

      <div class="footer__columns">
        <div class="footer__col">
          <p class="label footer__label" id="footer-hours">{hoursCopy.title}</p>
          <ul role="list" class="footer__hours" aria-labelledby="footer-hours">
            {
              hourRows.map((row) => (
                <li class="footer__text">
                  <span class="footer__day">
                    <span aria-hidden="true">{row.short}</span>
                    <span class="visually-hidden">{row.long}</span>
                  </span>
                  <span>{row.time}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <nav class="footer__col" aria-labelledby="footer-menu">
          <p class="label footer__label" id="footer-menu">{columns.menu}</p>
          <ul role="list">
            {site.nav.map((item) => <li><TextLink kind="footer" href={`${linkBase}#${item.anchor}`}>{footerLabel(item)}</TextLink></li>)}
          </ul>
        </nav>

        <div class="footer__col">
          <p class="label footer__label">{columns.studio.title}</p>
          <ul role="list">
            <li>
              <TextLink kind="footer" href={site.studio.googleMaps} external newTabLabel={ui.newTab}>
                {columns.studio.lines[0]}
              </TextLink>
            </li>
            {columns.studio.lines.slice(1).map((line) => <li class="footer__text">{line}</li>)}
          </ul>
        </div>

        <div class="footer__col">
          <p class="label footer__label">{columns.online.title}</p>
          <ul role="list">
            {
              online.map((link) => (
                <li>
                  <TextLink kind="footer" href={link.href} external newTabLabel={ui.newTab}>
                    {link.label}
                  </TextLink>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="label">{copyright}</p>
      <ul class="footer__legal" role="list">
        <li><TextLink kind="legal" aria-haspopup="dialog" data-open-dialog="privacy-policy">{privacyLabel}</TextLink></li>
        <li><TextLink kind="legal" aria-haspopup="dialog" data-open-dialog="cookie-settings">{cookiesLabel}</TextLink></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-footer);
    color: var(--text-inverse);
    padding-block: 48px 24px;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .footer__logo { border-radius: 4px; }
  .footer__logo img { width: 240px; height: 44px; }
  .footer__tagline { color: var(--text-inverse-subtle); }

  .footer__columns {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
  }
  /* Order: Godziny, Menu, Studio, Online. Mobile: a two-column grid, so Godziny + Menu
     (6 lines each) share the first row and Studio + Online the second. */
  .footer__col { min-width: 118px; }
  @media (max-width: 767px) {
    .footer__columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .footer__col { min-width: 0; }
  }
  /* Tablet: all four columns in one row across the full width. */
  @media (min-width: 768px) {
    .footer__columns {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 32px;
    }
    .footer__col { min-width: 0; }
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 14px;
  }
  /* Flex items so the list rows take the 17 / 15 px link height, not the body line height. */
  .footer__col li,
  .footer__legal li { display: flex; }

  .footer__label,
  .footer__bottom { color: var(--text-footer-label); }
  .footer__label { line-height: 15px; }

  .footer__text {
    font: var(--type-nav);
    line-height: var(--lh-nav);
    white-space: nowrap;
  }

  /* Opening hours: day names in a narrow column, times lined up beside them. */
  .footer__hours li { gap: 12px; }
  .footer__day {
    min-width: 52px;
    color: var(--text-inverse-subtle);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border-footer);
    line-height: 15px;
  }
  .footer__legal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  :where(.site-footer) :focus-visible { outline-color: var(--periwinkle-200); }

  @media (min-width: 1024px) {
    .site-footer { padding-block: 64px 32px; }
    .footer__inner { gap: 51px; }
    /* 1024–1279: the logo sits above the four columns (Menu, Studio, Godziny, Online),
       which spread across the full width; side by side they don't fit (UA menu is long). */
    .footer__columns {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 48px;
    }
    .footer__col { min-width: 0; }
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
    .footer__legal {
      flex-direction: row;
      gap: 24px;
    }
  }

  @media (min-width: 1280px) {
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      gap: 48px;
    }
    .footer__brand { flex-shrink: 0; }
    .footer__columns {
      justify-content: flex-start;
      gap: clamp(48px, 5vw, 96px);
    }
  }
</style>
