---
/**
 * Pop-up shell (overlays in Figma, e.g. 293:1219 desktop / 293:1327 mobile).
 * Built on <dialog> + showModal(): the rest of the page becomes inert (focus stays
 * inside), Esc closes, and the browser draws the dim.
 *
 * Desktop: centred card, `width` px wide. Mobile (<768): `mobile="sheet"` (a centred card
 * 12 px from the screen sides) or `mobile="fullscreen"`.
 *
 * Open:  any element with data-open-dialog="<id>", or openDialog(id) from scripts/dialogs.
 * Close: the close button, Esc, a click on the dim, or any [data-close-dialog] inside.
 * Title: [plain, italic] — the second part is set in plum italic.
 * size="large": 32 / 40 px padding, 32 px radius, bigger two-line title (gift form 165:887).
 * size="document": "large" with a fixed 760 px height where only the body scrolls
 * (privacy policy 226:1057).
 * tone="plum": plum card, white title with a periwinkle-200 italic line (gift form).
 */
import Icon from './Icon.astro';

type Props = {
  id: string;
  title: [string, string] | string[];
  closeLabel: string;
  width?: number;
  mobile?: 'sheet' | 'fullscreen';
  size?: 'default' | 'large' | 'document';
  tone?: 'light' | 'plum';
  /** Large/document titles break before the italic part; false keeps them on one line. */
  titleBreak?: boolean;
  /** Tighter spacing for tall content (the gift form). */
  compact?: boolean;
  class?: string;
};

const { id, title, closeLabel, width = 440, mobile = 'sheet', size = 'default', tone = 'light', titleBreak, compact = false, class: className } = Astro.props;
const twoLines = titleBreak ?? size !== 'default';
const [plain, italic] = title;
const titleId = `${id}-title`;
---

<dialog
  id={id}
  class:list={['modal', `modal--${mobile}`, `modal--${size}`, `modal--${tone}`, { 'modal--compact': compact }, className]}
  aria-labelledby={titleId}
  style={`--modal-width: ${width}px`}
  data-dialog
>
  <div class="modal__card">
    <div class="modal__top">
      <h2 class="modal__title" id={titleId}>
        {plain}{italic && (twoLines ? <><br /><em>{italic}</em></> : <> <em>{italic}</em></>)}
      </h2>
      <button type="button" class="modal__close" aria-label={closeLabel} data-close-dialog>
        <Icon name="close" />
      </button>
    </div>
    <div class="modal__body">
      <slot />
    </div>
  </div>
</dialog>

<script>
  import '../scripts/dialogs';
</script>

<style>
  .modal {
    width: min(var(--modal-width), 100% - 2 * var(--gutter-mobile));
    max-width: none;
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--border-default);
    border-radius: 24px;
    background: var(--bg-default);
    color: var(--text-primary);
    box-shadow: 0 24px 64px color-mix(in srgb, var(--plum-700) 30%, transparent);
    overflow: hidden;
  }

  .modal__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-height: inherit;
    padding: 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .modal__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  /* Blocks inside a pop-up sit 16 px apart, like the header and the body (Figma 293:1219, 232:1074). */
  .modal__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .modal__title {
    font: var(--type-h4);
    letter-spacing: var(--tracking-h4);
    color: var(--text-primary);
  }
  .modal__title em {
    font-style: italic;
    color: var(--text-highlight);
  }

  .modal__close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--plum-600);
    color: var(--text-inverse);
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  @media (hover: hover) {
    .modal__close:hover { background: var(--bg-highlight); }
  }

  /* ── Large (gift form) and document (privacy policy) ── */
  .modal--large,
  .modal--document {
    border: 0;
    border-radius: 32px;
  }
  .modal--large .modal__card,
  .modal--document .modal__card { padding: 32px 40px; }
  .modal--large .modal__top,
  .modal--document .modal__top { align-items: flex-start; }
  .modal--large .modal__title,
  .modal--document .modal__title {
    font: 400 32px/1.1 var(--font-serif);
    letter-spacing: -0.005em;
  }

  .modal--compact .modal__card { gap: 12px; }

  .modal--document { height: min(760px, 100dvh - 48px); }
  .modal--document .modal__card {
    height: 100%;
    gap: 24px;
    overflow: hidden;
  }
  .modal--document .modal__body {
    flex: 1;
    min-height: 0;
    padding-right: 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ── Plum tone ── */
  .modal--plum {
    background: var(--bg-highlight);
    color: var(--text-inverse);
  }
  .modal--plum .modal__title { color: var(--text-inverse); }
  .modal--plum .modal__title em { color: var(--text-inverse-subtle); }
  @media (hover: hover) {
    .modal--plum .modal__close:hover { background: var(--plum-700); }
  }
  .modal--plum :focus-visible { outline-color: var(--periwinkle-200); }

  .modal::backdrop {
    background: color-mix(in srgb, var(--plum-700) 45%, transparent);
  }

  /* Fade in / out, 200 ms. */
  .modal,
  .modal::backdrop {
    opacity: 0;
    transition:
      opacity var(--dur-overlay) var(--ease-out),
      overlay var(--dur-overlay) allow-discrete,
      display var(--dur-overlay) allow-discrete;
  }
  .modal[open],
  .modal[open]::backdrop { opacity: 1; }
  @starting-style {
    .modal[open],
    .modal[open]::backdrop { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal,
    .modal::backdrop { transition: none; }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    /* Floating card centred on screen, 12 px from the sides, all corners rounded. */
    .modal--sheet {
      width: calc(100% - 24px);
      max-height: calc(100dvh - 24px);
      margin: auto;
      border-radius: 24px;
    }
    .modal--sheet .modal__card { padding: 20px; }

    .modal--fullscreen {
      width: 100%;
      height: 100dvh;
      max-height: none;
      margin: 0;
      border: 0;
      border-radius: 0;
    }
    .modal--fullscreen .modal__card {
      height: 100%;
      padding: 20px;
    }
    .modal--large .modal__card,
    .modal--document .modal__card { padding: 20px; }
    .modal--document .modal__card { gap: 20px; }
    .modal--large .modal__title,
    .modal--document .modal__title { font-size: 28px; }
  }
</style>
